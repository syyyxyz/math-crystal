# Builds Math-crystal from the source of a tagged GitHub release.
# Before uploading to the AUR: run `updpkgsums`, then
# `makepkg --printsrcinfo > .SRCINFO`.
_owner=syyyxyz
pkgname=math-crystal
pkgver=0.1.1
pkgrel=1
pkgdesc="Visual math workbench: multivariable calculus, complex functions, Fourier spectra, space geometry"
arch=('x86_64')
url="https://github.com/$_owner/math-crystal"
license=('MIT' 'OFL-1.1' 'Bitstream-Vera')
depends=('gcc-libs' 'glibc' 'libxkbcommon' 'vulkan-icd-loader' 'hicolor-icon-theme')
optdepends=('wayland: Wayland sessions'
            'libxcursor: X11 sessions'
            'libxi: X11 sessions'
            'libxrandr: X11 sessions')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('6d9747e7f45bd344ff46898b61154c401fd6d2c60d61569997270855a4af82fd')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo test --frozen --lib
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/math-crystal -t "$pkgdir/usr/bin/"
  install -Dm644 packaging/linux/math-crystal.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 assets/icon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/math-crystal.png"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 assets/fonts/*.txt -t "$pkgdir/usr/share/licenses/$pkgname/fonts/"
}
