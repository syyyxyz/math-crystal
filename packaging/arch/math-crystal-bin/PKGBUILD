# Repackages the prebuilt Linux binary from a GitHub release.
# Before uploading to the AUR: run `updpkgsums`, then
# `makepkg --printsrcinfo > .SRCINFO`.
_owner=syyyxyz
pkgname=math-crystal-bin
pkgver=0.1.1
pkgrel=1
pkgdesc="Visual math workbench: multivariable calculus, complex functions, Fourier spectra, space geometry (prebuilt)"
arch=('x86_64')
url="https://github.com/$_owner/math-crystal"
license=('MIT' 'OFL-1.1' 'Bitstream-Vera')
depends=('gcc-libs' 'glibc' 'libxkbcommon' 'vulkan-icd-loader' 'hicolor-icon-theme')
optdepends=('wayland: Wayland sessions'
            'libxcursor: X11 sessions'
            'libxi: X11 sessions'
            'libxrandr: X11 sessions')
provides=('math-crystal')
conflicts=('math-crystal')
_dir="math-crystal-$pkgver-linux-x86_64"
source=("$url/releases/download/v$pkgver/$_dir.tar.gz")
sha256sums=('04f1b0d172e8670c232c35410da144de527d0c523522d629f04ebbada880139e')

package() {
  cd "$_dir"
  install -Dm755 math-crystal -t "$pkgdir/usr/bin/"
  install -Dm644 math-crystal.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 math-crystal.png -t "$pkgdir/usr/share/icons/hicolor/256x256/apps/"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 licenses/*.txt -t "$pkgdir/usr/share/licenses/$pkgname/fonts/"
}
